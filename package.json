{
  "name": "phoenix",
  "version": "0.0.0",
  "private": true,
  "description": "Durable AI agent on Postgres: replayable steps, leases, fencing tokens and an outbox, so crashes never cost twice",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:psql": "docker compose exec postgres sh -c \"psql -U $POSTGRES_USER -d $POSTGRES_DB\"",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "fake-llm": "tsx testing/fake-llm.ts",
    "chaos:p0": "bash testing/chaos/p0-smoke.sh",
    "seed": "tsx --env-file=.env testing/seed.ts",
    "chaos:p1": "bash testing/chaos/p1-baseline.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhajitchatterjee07/phoenix.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "openai": "7.57.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
